# =============================================================================
# AWS Infrastructure Monitoring Dashboard - environment variables
# Copy this file to .env and fill in the values:   cp .env.example .env
# NEVER commit .env. NEVER put AWS access keys in this file.
# None of these variables use the NEXT_PUBLIC_ prefix, so none reach the browser.
# =============================================================================

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# On macOS with Homebrew PostgreSQL, the default superuser is your macOS
# username and has no password. Run `whoami` to find it.
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/devops_dashboard"

# --- Authentication (Auth.js) -------------------------------------------------
# Secret used to sign/encrypt session tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
# Trust the Host header. Required when running behind Nginx in production.
AUTH_TRUST_HOST=true

# --- Initial admin user (used only by `npx prisma db seed`) -------------------
SEED_ADMIN_EMAIL="admin@example.com"
# At least 12 characters. Change it to your own value before seeding.
SEED_ADMIN_PASSWORD="change-me-to-a-long-password"
SEED_ADMIN_NAME="Administrator"

# --- Monitoring provider ------------------------------------------------------
# MOCK = generated demo data, no AWS account needed (local development).
# AWS  = real Amazon EC2 + CloudWatch data (Phase 2).
MONITORING_PROVIDER=MOCK

# --- AWS ----------------------------------------------------------------------
# Default region used when the database has no saved region yet.
AWS_REGION=us-east-1
# Optional: name of an AWS CLI profile from ~/.aws/config for LOCAL development
# in AWS mode. Leave empty on EC2: the instance's IAM role is used automatically.
# AWS_PROFILE=dashboard-readonly
# Timeout for each AWS API call, in milliseconds.
AWS_API_TIMEOUT_MS=10000
